 "decisions": [
  {
   "id": "D1",
   "topic": "drau'vaer",
   "decision": "означає «моє/моя». Фраза «Kaen drau'vaer» = «Я твоя» лишається канонічною в пам'яті фраз як усталений зворот; «твій» у нових перекладах = draer'n.",
   "status": "proposed"
  },
  {
   "id": "D2",
   "topic": "druun",
   "decision": "основне значення «пов'язаний, союзник»; «порятунок» — лише у звороті хору ghraal druun.",
   "status": "proposed"
  },
  {
   "id": "D3",
   "topic": "правопис",
   "decision": "нормативні форми: shael'ruun, khael'n, khaar'khaer'vaer; написання з постів зберігаються в корпусі як варіанти.",
   "status": "proposed"
  },
  {
   "id": "D4",
   "topic": "регістри",
   "decision": "у перекладачі два режими: «стандартна» і «голос Темряви». Ритуальна від розмовної лексично не відрізняється, тому окремого режиму не має.",
   "status": "proposed"
  },
  {
   "id": "D5",
   "topic": "заперечення",
   "decision": "«не» → no перед словом (у каноні no є лише в голосі Темряви; поширено на всю мову).",
   "status": "proposed"
  },
  {
   "id": "D6",
   "topic": "питання",
   "decision": "питання без питального слова починається з Vael'n.",
   "status": "derived"
  },
  {
   "id": "D7",
   "topic": "власні назви",
   "decision": "передаються латинкою за таблицею транслітерації; усталені: Крейн → Khaen, Вістрал → Vistral. «пані/пан + ім'я» → Ім'я'na.",
   "status": "derived"
  },
  {
   "id": "D8",
   "topic": "порядок слів",
   "decision": "зберігається порядок оригіналу; службові слова зі stopwords пропускаються.",
   "status": "proposed"
  }
 ],
